{ lib }:

rec {
  # The parts of lean4's meta that the kernel and its language server carry.
  fromPackage = lean4: {
    inherit (lean4) version;
    inherit (lean4.meta) name description homepage changelog mainProgram maintainers platforms;
    license = lean4.meta.license.spdxId;
  };

  # fromPackage at nixpkgs.nix's pin, generated by ./update.sh. Read from JSON so describing
  # the kernel doesn't import that nixpkgs.
  pinned = lib.importJSON ./meta.json;

  meta = pinned // { license = lib.getLicenseFromSpdxId pinned.license; };
}
