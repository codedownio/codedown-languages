#! /usr/bin/env nix-shell
#! nix-shell -i python3 -p python3 nix jq

"""Regenerate nix/lsp-capabilities.json.

For each kernel, builds a single-kernel environment, starts every language server that
kernel ships with at its default settings, performs the LSP `initialize` handshake, and
records the server's advertised capabilities.

This is the only part of the feature matrix that can't be answered by evaluating Nix: a
server's capabilities are whatever it says at runtime. Run this after upgrading nixpkgs
or changing which language servers a kernel enables.

A server that advertises `workspaceSymbolProvider` is then asked one further question,
recorded as `workspaceSymbolFindsCellSymbol`: can its workspace query find a symbol
declared in a cell of a notebook the client has open?

A server that advertises `diagnosticProvider` is asked the matching question for pulled
diagnostics, recorded as `diagnosticReportsCellProblem`: shown a cell that doesn't compile,
does `textDocument/diagnostic` come back with anything? Advertising the capability says
the server answers the request, not that it answers it for a projection.

The notebook is a real file on disk, but it's a container -- markdown, typst or latex --
and no language server reads it as source. What a server is shown instead is a projection:
this language's cells extracted into one document, opened at the notebook's path plus
`notebook_suffix` (so `analysis.md.py` for jedi), or at a shadow document a notebook
language server names for itself. Nothing is written at that path. A server that builds
its symbol index by walking the project therefore never parses the projection, and answers
for the project's real source files while leaving every cell out -- jedi and pyright both
do this.

Note the "has open". codedown builds a projection when a document is opened and not before,
so a notebook nobody has opened is invisible to every server here, whatever this field
says. A `true` means the server covers the notebook in front of you, not the project.

Usage:
    scripts/probe-lsp-capabilities              # all kernels
    scripts/probe-lsp-capabilities python3 go   # just these
"""

import json
import os
import select
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
OUTPUT = REPO / "nix" / "lsp-capabilities.json"

# initialize can be slow on servers that index up front (rust-analyzer, hls).
INITIALIZE_TIMEOUT_SECONDS = 300

# How long to wait after `initialized` for a server that registers capabilities dynamically.
REGISTRATION_WINDOW_SECONDS = 8

# How long to keep re-asking workspace/symbol while a server builds its index. Generous
# because jdtls spends minutes building its invisible project before it answers anything;
# only a server that never answers pays the whole thing.
WORKSPACE_SYMBOL_TIMEOUT_SECONDS = 300

# How long to keep asking for diagnostics while a server builds its index.
DIAGNOSTIC_TIMEOUT_SECONDS = 180

# What a user might type in a cell, per language_id: one declaration whose name contains
# "alpha". Sent as the notebook's contents, so it goes through the notebook language
# server exactly as a real cell would.
CELL_SOURCES = {
    "clojure": "(defn alpha-in-cell [] 2)\n",
    "cpp": "int alpha_in_cell() { return 2; }\n",
    "go": "func alphaInCell() int { return 2 }\n",
    "haskell": "alphaInCell :: Int\nalphaInCell = 2\n",
    "java": "int alphaInCell() { return 2; }\n",
    "javascript": "function alphaInCell() { return 2 }\n",
    "julia": "function alpha_in_cell()\n    2\nend\n",
    "python": "def alpha_in_cell():\n    return 2\n",
    "r": "alpha_in_cell <- function() 2\n",
    "ruby": "def alpha_in_cell\n  2\nend\n",
    "rust": "fn alpha_in_cell() -> i32 { 2 }\n",
    "shellscript": "alpha_in_cell() {\n  echo 2\n}\n",
    "typescript": "function alphaInCell() { return 2 }\n",
}

# The same cells, each with one plain mistake, for asking a server what it makes of a cell
# it can't compile.
BROKEN_CELL_SOURCES = {
    "cpp": "int alpha_in_cell() { return \"not an int\"; }\n",
    "go": "func alphaInCell() int { return \"not an int\" }\n",
    "haskell": "alphaInCell :: Int\nalphaInCell = \"not an int\"\n",
    "java": "int alphaInCell() { return \"not an int\"; }\n",
    "python": "def alpha_in_cell():\n    return undefined_name_in_cell\n",
    "ruby": "def alpha_in_cell\n  undefined_name_in_cell\nend\n",
    "rust": "fn alpha_in_cell() -> i32 { \"not an int\" }\n",
    "typescript": "function alphaInCell(): number { return \"not an int\" }\n",
}

# LSP request -> the field of ServerCapabilities that means the same thing, for servers
# that register dynamically instead of declaring in the initialize result.
REGISTRATION_TO_CAPABILITY = {
    "textDocument/completion": "completionProvider",
    "textDocument/hover": "hoverProvider",
    "textDocument/signatureHelp": "signatureHelpProvider",
    "textDocument/declaration": "declarationProvider",
    "textDocument/definition": "definitionProvider",
    "textDocument/typeDefinition": "typeDefinitionProvider",
    "textDocument/implementation": "implementationProvider",
    "textDocument/references": "referencesProvider",
    "textDocument/documentHighlight": "documentHighlightProvider",
    "textDocument/documentSymbol": "documentSymbolProvider",
    "workspace/symbol": "workspaceSymbolProvider",
    "textDocument/codeAction": "codeActionProvider",
    "textDocument/codeLens": "codeLensProvider",
    "textDocument/formatting": "documentFormattingProvider",
    "textDocument/rangeFormatting": "documentRangeFormattingProvider",
    "textDocument/onTypeFormatting": "documentOnTypeFormattingProvider",
    "textDocument/rename": "renameProvider",
    "textDocument/foldingRange": "foldingRangeProvider",
    "textDocument/selectionRange": "selectionRangeProvider",
    "textDocument/semanticTokens": "semanticTokensProvider",
    "textDocument/inlayHint": "inlayHintProvider",
    "textDocument/diagnostic": "diagnosticProvider",
}

# Ask for everything, so a server doesn't withhold a capability just because we didn't
# claim to support it. Servers only advertise what they can do *and* what we asked about.
CLIENT_CAPABILITIES = {
    "workspace": {
        "applyEdit": True,
        "workspaceEdit": {"documentChanges": True},
        "didChangeConfiguration": {"dynamicRegistration": False},
        "didChangeWatchedFiles": {"dynamicRegistration": False},
        "symbol": {"dynamicRegistration": False},
        "executeCommand": {"dynamicRegistration": False},
        "configuration": True,
        "workspaceFolders": True,
    },
    "textDocument": {
        "synchronization": {"dynamicRegistration": False, "willSave": True, "didSave": True},
        "completion": {
            "dynamicRegistration": False,
            "completionItem": {
                "snippetSupport": True,
                "documentationFormat": ["markdown", "plaintext"],
                "resolveSupport": {"properties": ["documentation", "detail"]},
            },
            "contextSupport": True,
        },
        "hover": {"dynamicRegistration": False, "contentFormat": ["markdown", "plaintext"]},
        "signatureHelp": {
            "dynamicRegistration": False,
            "signatureInformation": {"documentationFormat": ["markdown", "plaintext"]},
        },
        "declaration": {"dynamicRegistration": False, "linkSupport": True},
        "definition": {"dynamicRegistration": False, "linkSupport": True},
        "typeDefinition": {"dynamicRegistration": False, "linkSupport": True},
        "implementation": {"dynamicRegistration": False, "linkSupport": True},
        "references": {"dynamicRegistration": False},
        "documentHighlight": {"dynamicRegistration": False},
        "documentSymbol": {"dynamicRegistration": False, "hierarchicalDocumentSymbolSupport": True},
        "codeAction": {
            "dynamicRegistration": False,
            "codeActionLiteralSupport": {
                "codeActionKind": {
                    "valueSet": [
                        "", "quickfix", "refactor", "refactor.extract", "refactor.inline",
                        "refactor.rewrite", "source", "source.organizeImports",
                    ]
                }
            },
        },
        "codeLens": {"dynamicRegistration": False},
        "formatting": {"dynamicRegistration": False},
        "rangeFormatting": {"dynamicRegistration": False},
        "onTypeFormatting": {"dynamicRegistration": False},
        "rename": {"dynamicRegistration": False, "prepareSupport": True},
        "documentLink": {"dynamicRegistration": False},
        "colorProvider": {"dynamicRegistration": False},
        "foldingRange": {"dynamicRegistration": False, "lineFoldingOnly": True},
        "selectionRange": {"dynamicRegistration": False},
        "callHierarchy": {"dynamicRegistration": False},
        "typeHierarchy": {"dynamicRegistration": False},
        "semanticTokens": {
            "dynamicRegistration": False,
            "requests": {"range": True, "full": {"delta": True}},
            "tokenTypes": [
                "namespace", "type", "class", "enum", "interface", "struct", "typeParameter",
                "parameter", "variable", "property", "enumMember", "event", "function",
                "method", "macro", "keyword", "modifier", "comment", "string", "number",
                "regexp", "operator", "decorator",
            ],
            "tokenModifiers": [
                "declaration", "definition", "readonly", "static", "deprecated", "abstract",
                "async", "modification", "documentation", "defaultLibrary",
            ],
            "formats": ["relative"],
        },
        "inlayHint": {"dynamicRegistration": False, "resolveSupport": {"properties": ["tooltip"]}},
        "inlineValue": {"dynamicRegistration": False},
        "publishDiagnostics": {"relatedInformation": True},
        "diagnostic": {"dynamicRegistration": False, "relatedDocumentSupport": True},
        "linkedEditingRange": {"dynamicRegistration": False},
        "moniker": {"dynamicRegistration": False},
    },
    "window": {"workDoneProgress": True, "showMessage": {}, "showDocument": {"support": True}},
    "general": {
        "positionEncodings": ["utf-16"],
        "markdown": {"parser": "marked"},
    },
}


def run(cmd, **kwargs):
    return subprocess.run(cmd, cwd=REPO, check=True, capture_output=True, text=True, **kwargs).stdout


def kernel_names():
    out = run(["nix", "eval", "--json", ".#lspProbeEnvs.kernelNames"])
    return json.loads(out)


def build_env(kernel):
    out = run(["nix", "build", "--no-link", "--json", f".#lspProbeEnvs.{kernel}"])
    return Path(json.loads(out)[0]["outputs"]["out"])


def language_server_configs(env_path):
    """Every language server config in a built environment. The yaml files are JSON."""
    directory = env_path / "lib" / "codedown" / "language-servers"
    if not directory.is_dir():
        return []

    configs = []
    for f in sorted(directory.iterdir()):
        with open(f) as handle:
            configs.extend(json.load(handle))
    return configs


class LspError(Exception):
    pass


def read_message(stream):
    """Read one LSP message (Content-Length framed) off a binary stream."""
    length = None
    while True:
        line = stream.readline()
        if not line:
            raise LspError("server closed the connection")
        line = line.strip()
        if not line:
            break
        if line.lower().startswith(b"content-length:"):
            length = int(line.split(b":", 1)[1])
    if length is None:
        raise LspError("no Content-Length header")
    return json.loads(stream.read(length))


def write_message(stream, message):
    body = json.dumps(message).encode()
    stream.write(b"Content-Length: %d\r\n\r\n" % len(body))
    stream.write(body)
    stream.flush()


def answer_server_request(process, message):
    """Say nothing useful, but in the right shape -- workspace/configuration wants one
    answer per item, and LanguageServer.jl dies on a bare null where a list belongs."""
    if message.get("method") == "workspace/configuration":
        result = [None] * len(message.get("params", {}).get("items", []))
    else:
        result = None
    write_message(process.stdin, {"jsonrpc": "2.0", "id": message["id"], "result": result})


def collect_registrations(process, seconds):
    """Method names the server registers dynamically in the first few seconds after startup."""
    methods = []
    deadline = time.monotonic() + seconds
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return methods
        if not select.select([process.stdout], [], [], remaining)[0]:
            return methods
        try:
            message = read_message(process.stdout)
        except LspError:
            return methods

        if message.get("method") == "client/registerCapability":
            for registration in message.get("params", {}).get("registrations", []):
                methods.append(registration.get("method"))
        if "method" in message and "id" in message:
            answer_server_request(process, message)


def request(process, request_id, method, params, timeout):
    """Send a request and read until its answer comes back, answering the server meanwhile."""
    write_message(process.stdin, {
        "jsonrpc": "2.0", "id": request_id, "method": method, "params": params})
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([process.stdout], [], [], remaining)[0]:
            raise LspError(f"no {method} response within {timeout}s")
        message = read_message(process.stdout)
        if message.get("id") == request_id and "result" in message:
            return message["result"]
        if message.get("id") == request_id and "error" in message:
            raise LspError(f"{method} failed: {message['error']}")
        if "method" in message and "id" in message:
            answer_server_request(process, message)


def symbol_names(result):
    """`workspace/symbol` answers with SymbolInformation[], WorkspaceSymbol[] or null."""
    if not isinstance(result, list):
        return []
    return [s.get("name", "") for s in result if isinstance(s, dict)]


def probe_cell_symbol(process, config, workspace):
    """Can this server's workspace query find a symbol declared in a notebook cell?

    Set up the way codedown does it: a notebook on disk, and the projection opened at the
    notebook's path plus notebook_suffix, which is a path with nothing at it. An empty
    suffix means a notebook language server is in front and names its own shadow document,
    so the uri we open is the notebook's own.

    Returns True/False, or None if we couldn't tell -- a language with no snippet, or a
    server that can't even find the symbol with `textDocument/documentSymbol`, which would
    mean the cell never parsed rather than that the index missed it.
    """
    source = CELL_SOURCES.get(config.get("language_id"))
    if source is None:
        return None

    # Stands in for the notebook. A real one wraps its cells in markdown, typst or latex;
    # the cells on their own are what codedown and the test suite both send over LSP.
    (workspace / "main.ipynb").write_text(source)

    notebook = workspace / ("main.ipynb" + config.get("notebook_suffix", ""))
    write_message(process.stdin, {
        "jsonrpc": "2.0",
        "method": "textDocument/didOpen",
        "params": {"textDocument": {
            "uri": notebook.as_uri(), "languageId": config["language_id"],
            "version": 1, "text": source}},
    })

    request_id = 100
    deadline = time.monotonic() + WORKSPACE_SYMBOL_TIMEOUT_SECONDS
    found = False
    while time.monotonic() < deadline and not found:
        time.sleep(5)
        request_id += 1
        hits = symbol_names(request(process, request_id, "workspace/symbol",
                                    {"query": "alpha"}, timeout=60))
        found = any("alpha" in name.lower() for name in hits)

    if found:
        return True

    # Nothing came back. Distinguish "the index didn't have it" from "the cell didn't parse".
    request_id += 1
    outline = request(process, request_id, "textDocument/documentSymbol",
                      {"textDocument": {"uri": notebook.as_uri()}}, timeout=60)
    return False if flatten_symbol_names(outline) else None


def probe_cell_diagnostics(process, config, workspace):
    """Shown a cell that doesn't compile, does this server answer `textDocument/diagnostic`?

    Opened the way codedown opens a projection, as in probe_cell_symbol. Returns True when
    a full report comes back with at least one diagnostic, False when the server answers
    but has nothing to say about the cell, and None when we couldn't ask -- no snippet for
    this language, or the server never answered.
    """
    source = BROKEN_CELL_SOURCES.get(config.get("language_id"))
    if source is None:
        return None

    (workspace / "broken.ipynb").write_text(source)

    notebook = workspace / ("broken.ipynb" + config.get("notebook_suffix", ""))
    write_message(process.stdin, {
        "jsonrpc": "2.0",
        "method": "textDocument/didOpen",
        "params": {"textDocument": {
            "uri": notebook.as_uri(), "languageId": config["language_id"],
            "version": 1, "text": source}},
    })

    # Same patience as the symbol question: a server that is still indexing answers an
    # empty report rather than refusing.
    request_id = 200
    deadline = time.monotonic() + DIAGNOSTIC_TIMEOUT_SECONDS
    answered = False
    while time.monotonic() < deadline:
        time.sleep(5)
        request_id += 1
        report = request(process, request_id, "textDocument/diagnostic",
                         {"textDocument": {"uri": notebook.as_uri()}}, timeout=60)
        if not isinstance(report, dict):
            continue
        answered = True
        if report.get("items"):
            return True

    return False if answered else None


def flatten_symbol_names(symbols):
    """documentSymbol answers with a flat list or a tree; we only want the names."""
    names = []
    for symbol in symbols or []:
        names.append(symbol.get("name", ""))
        names.extend(flatten_symbol_names(symbol.get("children")))
    return names


def probe(config, workspace):
    """Start a language server, initialize it, and return its advertised capabilities."""
    env = dict(os.environ)
    env.update(config.get("env") or {})
    # The configs' PATH is deliberately minimal; keep ours on the end so the server can
    # still find basic tools.
    if (config.get("env") or {}).get("PATH"):
        env["PATH"] = config["env"]["PATH"] + ":" + os.environ.get("PATH", "")
    # Servers that cache or scratch under $HOME (jdtls's -data, rnls's shadow crate) should
    # do it inside the workspace, which goes away with the probe.
    env["HOME"] = str(workspace)

    process = subprocess.Popen(
        config["args"],
        cwd=workspace,
        env=env,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )

    try:
        write_message(process.stdin, {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "processId": os.getpid(),
                "clientInfo": {"name": "codedown-lsp-capability-probe", "version": "1"},
                "rootUri": workspace.as_uri(),
                "rootPath": str(workspace),
                # No workspaceFolders, matching codedown's own client, which leaves the
                # field unset. rust-analyzer prefers folders over rootUri when it gets
                # them, which would defeat rnls pointing it at the shadow crate.
                "capabilities": CLIENT_CAPABILITIES,
                "initializationOptions": config.get("initialization_options"),
                "trace": "off",
            },
        })

        # Skip over anything the server sends before answering (log messages, progress).
        capabilities = None
        deadline = time.monotonic() + INITIALIZE_TIMEOUT_SECONDS
        while capabilities is None:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([process.stdout], [], [], remaining)[0]:
                raise LspError(f"no initialize response within {INITIALIZE_TIMEOUT_SECONDS}s")
            message = read_message(process.stdout)
            if message.get("id") == 1 and "result" in message:
                capabilities = message["result"].get("capabilities", {})
            elif message.get("id") == 1 and "error" in message:
                raise LspError(f"initialize failed: {message['error']}")
            # Some servers block until we answer their requests (e.g. workspace/configuration).
            elif "method" in message and "id" in message:
                answer_server_request(process, message)

        # We ask for dynamicRegistration: false above so servers declare everything up
        # front, but a few register regardless. Give them a moment after `initialized` and
        # fold anything they register into the same shape.
        write_message(process.stdin, {"jsonrpc": "2.0", "method": "initialized", "params": {}})
        for method in collect_registrations(process, REGISTRATION_WINDOW_SECONDS):
            field = REGISTRATION_TO_CAPABILITY.get(method)
            if field and not capabilities.get(field):
                capabilities[field] = True

        finds_cell_symbol = None
        if capabilities.get("workspaceSymbolProvider"):
            try:
                finds_cell_symbol = probe_cell_symbol(process, config, workspace)
            except LspError:
                # Worth recording the capabilities even if the follow-up question failed.
                finds_cell_symbol = None

        reports_cell_problem = None
        if capabilities.get("diagnosticProvider"):
            try:
                reports_cell_problem = probe_cell_diagnostics(process, config, workspace)
            except LspError as e:
                # The server claims to answer pull requests and didn't; say which way it failed.
                print(f"[{e}]", end=" ", flush=True)

        return capabilities, finds_cell_symbol, reports_cell_problem
    finally:
        process.stdin.close()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def main():
    requested = sys.argv[1:]
    kernels = requested or kernel_names()

    previous = json.loads(OUTPUT.read_text()).get("kernels", {}) if OUTPUT.exists() else {}
    result = {}
    failures = []

    for kernel in kernels:
        print(f"=== {kernel}", flush=True)
        try:
            env_path = build_env(kernel)
        except subprocess.CalledProcessError as e:
            print(f"  build failed:\n{e.stderr}", flush=True)
            failures.append((kernel, None, "build failed"))
            continue

        configs = language_server_configs(env_path)
        if not configs:
            print("  no language servers", flush=True)
            result[kernel] = {}
            continue

        servers = {}
        for config in configs:
            name = config["name"]
            print(f"  probing {name}...", end=" ", flush=True)
            workspace = Path(tempfile.mkdtemp(prefix=f"lsp-probe-{kernel}-{name}-"))
            try:
                capabilities, finds_cell_symbol, reports_cell_problem = probe(config, workspace)
            except Exception as e:  # noqa: BLE001 - a broken server shouldn't stop the run
                print(f"FAILED ({e})", flush=True)
                failures.append((kernel, name, str(e)))
                continue
            finally:
                shutil.rmtree(workspace, ignore_errors=True)

            cells = {True: ", finds cell symbols", False: ", BLIND to cell symbols",
                     None: ""}[finds_cell_symbol]
            pulled = {True: ", reports cell problems", False: ", SILENT on cell problems",
                      None: ""}[reports_cell_problem]
            print(f"ok ({len(capabilities)} capabilities{cells}{pulled})", flush=True)
            servers[name] = {
                "displayName": config.get("display_name", name),
                "version": config.get("version"),
                "capabilities": capabilities,
                "workspaceSymbolFindsCellSymbol": finds_cell_symbol,
                "diagnosticReportsCellProblem": reports_cell_problem,
            }

        # If every server in a kernel failed, keep what the last good run recorded rather
        # than publishing an empty kernel.
        result[kernel] = servers or previous.get(kernel, {})

    # A partial run (specific kernels requested) updates in place rather than clobbering.
    existing = {}
    if requested and OUTPUT.exists():
        existing = json.loads(OUTPUT.read_text()).get("kernels", {})
    existing.update(result)

    OUTPUT.write_text(json.dumps(
        {
            "comment": "Generated by scripts/probe-lsp-capabilities. Do not edit by hand.",
            "kernels": dict(sorted(existing.items())),
        },
        indent=2,
        sort_keys=True,
    ) + "\n")
    print(f"\nWrote {OUTPUT}", flush=True)

    if failures:
        print("\nFailures:", flush=True)
        for kernel, server, message in failures:
            print(f"  {kernel}/{server}: {message}", flush=True)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
